{%- comment -%}
  Black Friday 2026 VIP early-access sign-up.
  Subscribes the visitor to a Klaviyo list through Klaviyo's client subscriptions API
  (public key only, safe to expose). SMS consent is sent as a second request so an SMS
  failure never blocks the email sign-up.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign accent = section.settings.accent_color
-%}

<style>
  #bfvip-{{ sid }} { --forest: #0D301F; --ink: #1D1E20; --leaf: {{ accent }}; --sky: #B5CFEE; background: {{ section.settings.bg_color }}; color: var(--ink); }
  #bfvip-{{ sid }} .bfvip__wrap { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(24px, 3vw, 48px); padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #bfvip-{{ sid }} .bfvip__copy { flex: 1.15 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  #bfvip-{{ sid }} .bfvip__media { flex: 0.85 1 340px; min-width: 0; position: relative; }
  #bfvip-{{ sid }} .bfvip__media img { width: 100%; height: clamp(240px, 30vw, 440px); object-fit: cover; display: block; }
  #bfvip-{{ sid }} .bfvip__badge { position: absolute; top: -14px; right: -8px; width: 112px; height: 112px; border-radius: 999px; background: var(--leaf); border: 2px solid var(--forest); color: var(--forest); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; line-height: 1; text-transform: uppercase; }
  #bfvip-{{ sid }} .bfvip__badge strong { font-size: 34px; font-weight: 700; letter-spacing: -.02em; }
  #bfvip-{{ sid }} .bfvip__badge span { font-size: 12px; font-weight: 700; letter-spacing: .04em; margin-top: 4px; max-width: 90px; }
  #bfvip-{{ sid }} .bfvip__eyebrow { margin: 0; color: var(--forest); font-size: 14px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  #bfvip-{{ sid }} h1 { margin: 0; color: var(--forest); font-size: clamp(28px, 3.2vw, 44px); line-height: 1.08; letter-spacing: -.01em; font-weight: 700; text-transform: uppercase; }
  #bfvip-{{ sid }} h1 em { font-style: normal; color: {{ section.settings.highlight_color }}; }
  #bfvip-{{ sid }} .bfvip__sub { margin: 0; font-size: 16px; line-height: 1.45; color: var(--ink); max-width: 560px; }
  #bfvip-{{ sid }} .bfvip__sub p { margin: 0; }
  #bfvip-{{ sid }} .bfvip__box { max-width: 560px; padding: 4px 0; }
  #bfvip-{{ sid }} .bfvip__box-title { margin: 0 0 10px; color: #0B552B; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  #bfvip-{{ sid }} .bfvip__perks { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 16px; font-weight: 500; color: var(--ink); }
  #bfvip-{{ sid }} .bfvip__perks li { display: flex; gap: 10px; align-items: center; }
  #bfvip-{{ sid }} .bfvip__perks svg { flex: none; width: 24px; height: 24px; padding: 5px; border-radius: 999px; background: var(--leaf); box-sizing: border-box; }
  #bfvip-{{ sid }} form { display: flex; flex-direction: column; gap: 10px; max-width: 560px; }
  #bfvip-{{ sid }} .bfvip__row { display: flex; flex-wrap: wrap; gap: 10px; }
  #bfvip-{{ sid }} input[type="email"], #bfvip-{{ sid }} input[type="tel"] { flex: 1 1 220px; min-width: 0; height: 50px; border-radius: 999px; border: 2px solid var(--forest); background: #FFFFFF; color: var(--ink); padding: 0 22px; font: inherit; font-size: 16px; }
  #bfvip-{{ sid }} input::placeholder { color: #55605A; }
  #bfvip-{{ sid }} input:focus-visible, #bfvip-{{ sid }} button:focus-visible { outline: 3px solid var(--forest); outline-offset: 2px; }
  #bfvip-{{ sid }} .bfvip__consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; line-height: 1.45; color: #55605A; }
  #bfvip-{{ sid }} .bfvip__consent input { width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--forest); flex: none; }
  #bfvip-{{ sid }} button[type="submit"] { height: 50px; border-radius: 999px; border: 2px solid var(--forest); background: var(--leaf); color: var(--forest); padding: 0 40px; font: inherit; font-size: 16px; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; cursor: pointer; }
  #bfvip-{{ sid }} button[type="submit"]:hover { background: #98DB9F; }
  #bfvip-{{ sid }} button[disabled] { opacity: .6; cursor: wait; }
  #bfvip-{{ sid }} .bfvip__msg { font-size: 14px; margin: 0; }
  #bfvip-{{ sid }} .bfvip__msg:empty { display: none; }
  #bfvip-{{ sid }} .bfvip__msg--error { color: #A3261B; }
  #bfvip-{{ sid }} .bfvip__done { display: none; background: var(--sky); border: 2px solid var(--forest); padding: 22px 24px; max-width: 560px; }
  #bfvip-{{ sid }} .bfvip__done h2 { margin: 0 0 6px; color: var(--forest); font-size: 22px; font-weight: 700; text-transform: uppercase; }
  #bfvip-{{ sid }} .bfvip__done p { margin: 0; color: var(--ink); font-size: 16px; line-height: 1.5; }
  #bfvip-{{ sid }}.is-done form { display: none; }
  #bfvip-{{ sid }}.is-done .bfvip__done { display: block; }
  #bfvip-{{ sid }} .bfvip__fine { font-size: 12px; color: #55605A; margin: 0; }
  #bfvip-{{ sid }} .bfvip__fine p { margin: 0; }
  #bfvip-{{ sid }} .bfvip__fine a { color: inherit; }
  #bfvip-{{ sid }} .bfvip__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

<section id="bfvip-{{ sid }}" class="bfvip" data-company="{{ section.settings.klaviyo_public_key | escape }}" data-list="{{ section.settings.klaviyo_list_id | escape }}" data-sms-list="{{ section.settings.klaviyo_sms_list_id | escape }}">
  <div class="page-width bfvip__wrap">
    <div class="bfvip__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="bfvip__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <div class="bfvip__sub">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="bfvip__box">
        {%- if section.settings.perks_title != blank -%}<p class="bfvip__box-title">{{ section.settings.perks_title | escape }}</p>{%- endif -%}
        <ul class="bfvip__perks">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0D301F" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
        </div>
      {%- endif -%}

      <form novalidate>
        <div class="bfvip__row">
          <label for="bfvip-email-{{ sid }}" class="visually-hidden">Email address</label>
          <input id="bfvip-email-{{ sid }}" type="email" name="email" autocomplete="email" placeholder="Your email address" required>
        {%- if section.settings.show_phone -%}
            <label for="bfvip-phone-{{ sid }}" class="visually-hidden">Mobile number (optional)</label>
            <input id="bfvip-phone-{{ sid }}" type="tel" name="phone" autocomplete="tel" placeholder="Mobile (optional)">
        {%- endif -%}
        </div>
        {%- if section.settings.show_phone -%}
          <label class="bfvip__consent">
            <input type="checkbox" name="sms_consent">
            <span>{{ section.settings.sms_consent_text | escape }}</span>
          </label>
        {%- endif -%}
        <div class="bfvip__hp" aria-hidden="true"><label>Leave this empty <input type="text" name="company_website" tabindex="-1" autocomplete="off"></label></div>
        <div class="bfvip__row">
          <button type="submit" style="flex: 1 1 auto;">{{ section.settings.button_label | escape }}</button>
        </div>
        <p class="bfvip__msg" role="status" aria-live="polite"></p>
        {%- if section.settings.fine_print != blank -%}
          <div class="bfvip__fine">{{ section.settings.fine_print }}</div>
        {%- endif -%}
      </form>

      <div class="bfvip__done" role="status">
        <h2>{{ section.settings.success_heading | escape }}</h2>
        <div>{{ section.settings.success_text }}</div>
      </div>
    </div>

    <div class="bfvip__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 600px, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      {%- elsif all_products['rescue-dog-wee-repair'].featured_image != blank -%}
        {{ all_products['rescue-dog-wee-repair'].featured_image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 600px, 100vw', alt: 'RESCUE Dog Wee Repair' }}
      {%- endif -%}
      {%- if section.settings.badge_big != blank -%}
        <div class="bfvip__badge" aria-hidden="true"><strong>{{ section.settings.badge_big | escape }}</strong><span>{{ section.settings.badge_small | escape }}</span></div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('bfvip-{{ sid }}');
    if (!root) return;
    var form = root.querySelector('form');
    var msg = root.querySelector('.bfvip__msg');
    var btn = form.querySelector('button[type="submit"]');
    var company = root.dataset.company;
    var listId = root.dataset.list;
    var smsListId = root.dataset.smsList || listId;
    var source = {{ section.settings.source_label | json }};

    function toE164(raw) {
      var d = (raw || '').replace(/[^\d+]/g, '');
      if (!d) return '';
      if (d.indexOf('+') === 0) return d;
      if (d.indexOf('61') === 0) return '+' + d;
      if (d.indexOf('0') === 0) return '+61' + d.slice(1);
      if (d.indexOf('4') === 0 && d.length === 9) return '+61' + d;
      return '';
    }

    function subscribe(profileAttrs, channels, list) {
      return fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(company), {
        method: 'POST',
        headers: { 'Content-Type': 'application/vnd.api+json', revision: '2024-10-15' },
        body: JSON.stringify({
          data: {
            type: 'subscription',
            attributes: {
              custom_source: source,
              profile: { data: { type: 'profile', attributes: profileAttrs } },
              subscriptions: channels
            },
            relationships: { list: { data: { type: 'list', id: list } } }
          }
        })
      }).then(function (r) {
        if (!r.ok) throw new Error('Klaviyo ' + r.status);
      });
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      msg.textContent = '';
      msg.classList.remove('bfvip__msg--error');
      if (form.company_website && form.company_website.value) return;

      var email = (form.email.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = 'Please enter a valid email address.';
        msg.classList.add('bfvip__msg--error');
        form.email.focus();
        return;
      }
      if (!company || !listId) {
        msg.textContent = 'Sign-up is not connected yet.';
        msg.classList.add('bfvip__msg--error');
        return;
      }

      var phone = form.phone ? toE164(form.phone.value) : '';
      var smsOk = form.sms_consent && form.sms_consent.checked && phone;
      if (form.phone && form.phone.value && !phone) {
        msg.textContent = 'Please enter an Australian mobile number, or leave it blank.';
        msg.classList.add('bfvip__msg--error');
        form.phone.focus();
        return;
      }

      btn.disabled = true;
      var props = { bfcm_2026_vip: true, bfcm_2026_vip_signup_source: source };

      subscribe({ email: email, properties: props }, { email: { marketing: { consent: 'SUBSCRIBED' } } }, listId)
        .then(function () {
          if (!smsOk) return;
          return subscribe({ email: email, phone_number: phone, properties: props }, { sms: { marketing: { consent: 'SUBSCRIBED' } } }, smsListId)
            .catch(function () { /* SMS is optional; email sign-up already succeeded */ });
        })
        .then(function () {
          root.classList.add('is-done');
          if (window._learnq) window._learnq.push(['identify', { $email: email }]);
        })
        .catch(function () {
          msg.textContent = 'Something went wrong. Please try again in a moment.';
          msg.classList.add('bfvip__msg--error');
        })
        .finally(function () { btn.disabled = false; });
    });
  })();
</script>

{% schema %}
{
  "name": "BF VIP sign-up",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Klaviyo" },
    { "type": "text", "id": "klaviyo_public_key", "label": "Klaviyo public API key (site ID)", "default": "WDVM9f" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list ID", "default": "SEKPaT", "info": "List: BFCM 2026 VIP Early Access" },
    { "type": "text", "id": "klaviyo_sms_list_id", "label": "Klaviyo list ID for SMS (optional)", "info": "Leave blank to use the same list" },
    { "type": "text", "id": "source_label", "label": "Sign-up source label", "default": "BFCM 2026 VIP page" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "VIP early access · Black Friday 2026" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "VIPs shop 30% off first. <em>Plus $60 in free bonuses.</em>" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Join the list for early access on Friday 20 November, a day before everyone else.</p>" },
    { "type": "text", "id": "perks_title", "label": "Perks box title", "default": "VIP day only: Friday 20 November" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get VIP access" },
    { "type": "checkbox", "id": "show_phone", "label": "Show mobile number field", "default": true },
    { "type": "text", "id": "sms_consent_text", "label": "SMS consent text", "default": "Text me when VIP access opens and about My Lawn Co offers. Msg frequency varies. Reply STOP to opt out." },
    { "type": "richtext", "id": "fine_print", "label": "Fine print", "default": "<p>By signing up you agree to receive emails from My Lawn Co. Unsubscribe anytime. See our <a href=\"/policies/privacy-policy\">privacy policy</a>.</p>" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "You're on the VIP list" },
    { "type": "richtext", "id": "success_text", "label": "Success text", "default": "<p>We'll email you on Friday 20 November when VIP early access opens. Keep an eye on your inbox (and your spam folder, just in case).</p>" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "badge_big", "label": "Badge large text", "default": "$60" },
    { "type": "text", "id": "badge_small", "label": "Badge small text", "default": "FREE BONUSES" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F7F5E9" },
    { "type": "color", "id": "accent_color", "label": "Accent (box, button, badge)", "default": "#70C27A" },
    { "type": "color", "id": "highlight_color", "label": "Heading highlight", "default": "#0B552B" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "30% off everything, before anyone else" } ]
    }
  ],
  "presets": [
    {
      "name": "BF VIP sign-up",
      "blocks": [
        { "type": "perk", "settings": { "text": "30% off everything, before anyone else" } },
        { "type": "perk", "settings": { "text": "Free $20 gift voucher" } },
        { "type": "perk", "settings": { "text": "Free Yearly Lawn Program, worth $40" } }
      ]
    }
  ]
}
{% endschema %}
