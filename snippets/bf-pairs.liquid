{%- comment -%}
  "Pairs well with" upsells for product pages, replacing the Essential Upsell app's
  product page offer (which only ever offered the Lawn Program and the free guide).
  Rendered from a "Custom liquid" block under Add to cart: {% render 'bf-pairs' %}
  Map: product handle = comma-separated handles to offer, in order (max 3 shown).
  Products already in the cart, sold out, or missing are skipped.
{%- endcomment -%}
{%- liquid
  assign map = 'rescue-dog-wee-repair=grow-rescue-bundle,thrive-liquid-fertiliser,grow-granular-fertiliser|grow-granular-fertiliser=thrive-liquid-fertiliser,vital-wetting-agent,enrich|thrive-liquid-fertiliser=grow-granular-fertiliser,revive-traces,enrich|revive-traces=thrive-liquid-fertiliser,enrich|enrich=vital-wetting-agent,grow-granular-fertiliser|vital-wetting-agent=grow-granular-fertiliser,enrich|grow-rescue-bundle=thrive-liquid-fertiliser,vital-wetting-agent|grow-thrive-bundle=rescue-dog-wee-repair,vital-wetting-agent|healthy-soil-bundle=healthy-leaf-bundle,rescue-dog-wee-repair|healthy-leaf-bundle=healthy-soil-bundle,rescue-dog-wee-repair|complete-lawn-health-bundle=rescue-dog-wee-repair|the-ultimate-lawn-program-a-yearly-lawn-care-program=rescue-dog-wee-repair,grow-thrive-bundle|a-beginners-guide-to-the-perfect-lawn=rescue-dog-wee-repair,grow-thrive-bundle' | split: '|'
  assign offers = ''
  for row in map
    assign pair = row | split: '='
    if pair[0] == product.handle
      assign offers = pair[1] | split: ','
    endif
  endfor
  assign in_cart = cart.items | map: 'product_id' | join: ',' | prepend: ',' | append: ','
  assign shown = 0
-%}
<style>
  [data-essential-upsell-funnel-id="ff08a33f-c120-4321-a958-f86d2431b2cb"] { display: none !important; }
  .bf-pairs { margin: 18px 0 6px; }
  .bf-pairs__title { margin: 0 0 10px; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #0B552B; }
  .bf-pairs__list { display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .bf-pairs__item { display: flex; align-items: center; gap: 12px; padding: 8px 10px; border: 1.5px solid #0D301F; border-radius: 12px; background: #fff; }
  .bf-pairs__img { flex: none; width: 56px; height: 56px; border-radius: 8px; overflow: hidden; background: #F7F5E9; }
  .bf-pairs__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bf-pairs__info { flex: 1; min-width: 0; line-height: 1.3; }
  .bf-pairs__name { display: block; color: #0D301F; font-size: 14px; font-weight: 700; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bf-pairs__name:hover { text-decoration: underline; }
  .bf-pairs__price { font-size: 13px; color: #1D1E20; }
  .bf-pairs__price s { color: #7A857F; margin-left: 4px; }
  .bf-pairs__btn { flex: none; min-width: 72px; height: 38px; padding: 0 14px; border: 2px solid #0D301F; border-radius: 999px; background: #70C27A; color: #0D301F; font: inherit; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; cursor: pointer; }
  .bf-pairs__btn:hover { background: #98DB9F; }
  .bf-pairs__btn[disabled] { opacity: .6; cursor: default; }
</style>
{%- if offers != '' -%}
  {%- capture items -%}
    {%- for h in offers -%}
      {%- assign p = all_products[h] -%}
      {%- if p == blank or p.available == false or shown >= 3 -%}{%- continue -%}{%- endif -%}
      {%- assign pid = p.id | prepend: ',' | append: ',' -%}
      {%- if in_cart contains pid -%}{%- continue -%}{%- endif -%}
      {%- assign v = p.selected_or_first_available_variant -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="bf-pairs__item">
        <a class="bf-pairs__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
          {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
        </a>
        <div class="bf-pairs__info">
          <a class="bf-pairs__name" href="{{ p.url }}">{{ p.title | escape }}</a>
          <span class="bf-pairs__price">{{ v.price | money }}{% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% endif %}</span>
        </div>
        <button type="button" class="bf-pairs__btn" data-bf-pair-add="{{ v.id }}" aria-label="Add {{ p.title | escape }} to cart">Add</button>
      </li>
    {%- endfor -%}
  {%- endcapture -%}
  {%- if shown > 0 -%}
    <div class="bf-pairs">
      <p class="bf-pairs__title">Pairs well with</p>
      <ul class="bf-pairs__list">{{ items }}</ul>
    </div>
    <script>
      (function () {
        if (window.__bfPairsBound) return;
        window.__bfPairsBound = true;
        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-bf-pair-add]');
          if (!btn) return;
          e.preventDefault();
          var cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
          var body = { items: [{ id: Number(btn.getAttribute('data-bf-pair-add')), quantity: 1 }] };
          if (cart && cart.getSectionsToRender) {
            body.sections = cart.getSectionsToRender().map(function (s) { return s.id; });
            body.sections_url = window.location.pathname;
          }
          btn.disabled = true;
          var label = btn.textContent;
          btn.textContent = '…';
          fetch((window.routes && window.routes.cart_add_url) || '/cart/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(body)
          })
            .then(function (r) { return r.json(); })
            .then(function (res) {
              if (res.status) throw new Error(res.description || 'Could not add');
              btn.textContent = 'Added';
              if (cart && cart.renderContents) {
                if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
                cart.renderContents(res);
              } else {
                window.location.href = (window.routes && window.routes.cart_url) || '/cart';
              }
              if (window.publish && window.PUB_SUB_EVENTS) window.publish(PUB_SUB_EVENTS.cartUpdate, { source: 'bf-pairs', cartData: res });
            })
            .catch(function () { btn.textContent = label; btn.disabled = false; });
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}
