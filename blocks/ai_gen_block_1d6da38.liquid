{% doc %}
  @prompt
    create two columns, both with headers, body text and primary buttons, add a 3rd column to the left but make it more on it's own as a header style column. It needs to hold information like this:
    
    Topics that can be covered when you book in a personalised consultation:
    
    ✓   Lawn Care Tips 
    
    ✓   Weed/Disease Identification & Treatment
    
    ✓   Irrigation System and Watering
    
    ✓   Water & PH Soil Testing
    
    ✓   Suitable Grass Species
    
    ✓   Renovation and Replanting Lawns
    
    ✓   Lawn Challenges
    
    then right justify the other two columns more to the right, can you make this header be above all the columns to the left: Topics that can be covered when you book in a personalised consultation:, add margin options to this header so it doesnt space across the page: Topics that can be covered when you book in a personalised consultation:, increare right margin distance to 1000, make the left hand column shorter than the other two. make it come up under the text., add a section width adjuster
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-columns-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-three-columns__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
  }

  .ai-three-columns__header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_bottom_margin }}px;
    margin-left: {{ block.settings.header_left_margin }}px;
    margin-right: {{ block.settings.header_right_margin }}px;
  }

  .ai-three-columns__header-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.header_title_size }}px;
    color: {{ block.settings.header_title_color }};
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-three-columns__content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: start;
  }

  .ai-three-columns__checklist-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.checklist_gap }}px;
    padding: {{ block.settings.checklist_column_padding }}px;
    background-color: {{ block.settings.checklist_column_background }};
    border-radius: {{ block.settings.border_radius }}px;
    align-self: start;
  }

  .ai-three-columns__checklist-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.checklist_gap }}px;
  }

  .ai-three-columns__checklist-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: {{ block.settings.checklist_text_size }}px;
    color: {{ block.settings.checklist_text_color }};
    line-height: 1.5;
  }

  .ai-three-columns__checkmark-{{ ai_gen_id }} {
    color: {{ block.settings.checkmark_color }};
    font-weight: 700;
    flex-shrink: 0;
    font-size: {{ block.settings.checklist_text_size }}px;
  }

  .ai-three-columns__right-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    grid-column: 2 / 4;
  }

  .ai-three-columns__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
    padding: {{ block.settings.column_padding }}px;
    background-color: {{ block.settings.column_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-three-columns__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
  }

  .ai-three-columns__text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-three-columns__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .ai-three-columns__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-three-columns__content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-three-columns__right-columns-{{ ai_gen_id }} {
      grid-column: 1;
      grid-template-columns: 1fr;
    }

    .ai-three-columns__header-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_title_size | times: 0.85 }}px;
    }

    .ai-three-columns__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-three-columns__header-{{ ai_gen_id }} {
      margin-left: 0;
      margin-right: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-three-columns__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-three-columns__checklist-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.checklist_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<three-columns-{{ ai_gen_id }} class="ai-three-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-columns__container-{{ ai_gen_id }}">
    {% if block.settings.header_title != blank %}
      <div class="ai-three-columns__header-{{ ai_gen_id }}">
        <h2 class="ai-three-columns__header-title-{{ ai_gen_id }}">{{ block.settings.header_title }}</h2>
      </div>
    {% endif %}

    <div class="ai-three-columns__content-{{ ai_gen_id }}">
      <div class="ai-three-columns__checklist-column-{{ ai_gen_id }}">
        <ul class="ai-three-columns__checklist-{{ ai_gen_id }}">
          {% if block.settings.checklist_item_1 != blank %}
            <li class="ai-three-columns__checklist-item-{{ ai_gen_id }}">
              <span class="ai-three-columns__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.checklist_item_1 }}</span>
            </li>
          {% endif %}
          {% if block.settings.checklist_item_2 != blank %}
            <li class="ai-three-columns__checklist-item-{{ ai_gen_id }}">
              <span class="ai-three-columns__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.checklist_item_2 }}</span>
            </li>
          {% endif %}
          {% if block.settings.checklist_item_3 != blank %}
            <li class="ai-three-columns__checklist-item-{{ ai_gen_id }}">
              <span class="ai-three-columns__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.checklist_item_3 }}</span>
            </li>
          {% endif %}
          {% if block.settings.checklist_item_4 != blank %}
            <li class="ai-three-columns__checklist-item-{{ ai_gen_id }}">
              <span class="ai-three-columns__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.checklist_item_4 }}</span>
            </li>
          {% endif %}
          {% if block.settings.checklist_item_5 != blank %}
            <li class="ai-three-columns__checklist-item-{{ ai_gen_id }}">
              <span class="ai-three-columns__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.checklist_item_5 }}</span>
            </li>
          {% endif %}
          {% if block.settings.checklist_item_6 != blank %}
            <li class="ai-three-columns__checklist-item-{{ ai_gen_id }}">
              <span class="ai-three-columns__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.checklist_item_6 }}</span>
            </li>
          {% endif %}
          {% if block.settings.checklist_item_7 != blank %}
            <li class="ai-three-columns__checklist-item-{{ ai_gen_id }}">
              <span class="ai-three-columns__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.checklist_item_7 }}</span>
            </li>
          {% endif %}
        </ul>
      </div>

      <div class="ai-three-columns__right-columns-{{ ai_gen_id }}">
        <div class="ai-three-columns__column-{{ ai_gen_id }}">
          {% if block.settings.column_1_heading != blank %}
            <h3 class="ai-three-columns__heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
          {% endif %}
          {% if block.settings.column_1_text != blank %}
            <div class="ai-three-columns__text-{{ ai_gen_id }}">{{ block.settings.column_1_text }}</div>
          {% endif %}
          {% if block.settings.column_1_button_text != blank %}
            <a href="{{ block.settings.column_1_button_link }}" class="ai-three-columns__button-{{ ai_gen_id }}">
              {{ block.settings.column_1_button_text }}
            </a>
          {% endif %}
        </div>

        <div class="ai-three-columns__column-{{ ai_gen_id }}">
          {% if block.settings.column_2_heading != blank %}
            <h3 class="ai-three-columns__heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
          {% endif %}
          {% if block.settings.column_2_text != blank %}
            <div class="ai-three-columns__text-{{ ai_gen_id }}">{{ block.settings.column_2_text }}</div>
          {% endif %}
          {% if block.settings.column_2_button_text != blank %}
            <a href="{{ block.settings.column_2_button_link }}" class="ai-three-columns__button-{{ ai_gen_id }}">
              {{ block.settings.column_2_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</three-columns-{{ ai_gen_id }}>

<script>
  (function() {
    class ThreeColumns{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('three-columns-{{ ai_gen_id }}', ThreeColumns{{ ai_gen_id }});
  })();
</script>

